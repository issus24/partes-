# Copiá este archivo como .env para desarrollo local.
# En Railway, cargá estas mismas claves en Variables.

# PIN de la oficina: puede todo (crear, editar, borrar vehículos, importar).
PIN_OFICINA=1234

# PIN del taller: carga actualizaciones y pedidos, no borra vehículos.
PIN_TALLER=5678

# Clave para firmar las sesiones. Poné una cadena larga y aleatoria.
# Si la cambiás, todos tienen que volver a ingresar el PIN.
SECRETO=cambiar-por-una-cadena-larga-y-aleatoria

# La provee Railway automáticamente al agregar el plugin de Postgres.
# Si no está definida, el servidor guarda en datos/datos.json (solo desarrollo).
# DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos

NODE_ENV=production
